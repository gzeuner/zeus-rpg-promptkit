# Copy to config/local-only/.env.external-readonly.local and keep the values local.
# The JDBC driver JAR is installed separately under java/lib/ and is never selected by CLI input.
ZEUS_JDBC_REPORTING_DRIVER=YOUR_VENDOR_JDBC_DRIVER_CLASS
ZEUS_JDBC_REPORTING_URL=jdbc:YOUR_VENDOR://YOUR_DATABASE_HOST:0000/YOUR_DATABASE
ZEUS_JDBC_REPORTING_USER=YOUR_READONLY_DATABASE_USER
ZEUS_JDBC_REPORTING_PASSWORD=enc:v1:REPLACE_WITH_LOCAL_SECRET_TOKEN
ZEUS_JDBC_ONLY=true
