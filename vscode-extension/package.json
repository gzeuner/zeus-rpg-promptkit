{
  "name": "zeus-rpg-promptkit-vscode",
  "displayName": "Zeus RPG PromptKit",
  "description": "Optional, local-first VS Code adapter for explicit Zeus legacy-source analysis context.",
  "version": "0.1.0",
  "publisher": "gzeuner",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:zeus.analyzeCurrent",
    "onCommand:zeus.showWorkingContext",
    "onCommand:zeus.setWorkingSourceRoot",
    "onCommand:zeus.clearWorkingSourceRoot",
    "onView:zeus.analyses"
  ],
  "main": "./dist/extension.js",
  "files": [
    "dist",
    "README.md",
    "package.json",
    "LICENSE"
  ],
  "contributes": {
    "commands": [
      {
        "command": "zeus.analyzeCurrent",
        "title": "Zeus: Analyze Current Program/Member"
      },
      {
        "command": "zeus.showWorkingContext",
        "title": "Zeus: Show Working Context"
      },
      {
        "command": "zeus.setWorkingSourceRoot",
        "title": "Zeus: Set Working Source Root"
      },
      {
        "command": "zeus.clearWorkingSourceRoot",
        "title": "Zeus: Clear Working Source Root"
      },
      {
        "command": "zeus.openLatestReport",
        "title": "Zeus: Open Latest Report"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "zeus.analyzeCurrent",
          "group": "zeus"
        }
      ],
      "view/title": [
        {
          "command": "zeus.analyzeCurrent",
          "when": "view == zeus.analyses"
        }
      ]
    },
    "views": {
      "explorer": [
        {
          "id": "zeus.analyses",
          "name": "Zeus Analyses"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "zeus.analyses",
        "contents": "Run Zeus analysis on the current member to see evidence and reports here.\n[Analyze Current](command:zeus.analyzeCurrent)\n[Show Working Context](command:zeus.showWorkingContext)"
      }
    ],
    "configuration": {
      "title": "Zeus RPG PromptKit",
      "properties": {
        "zeus.defaultProfile": {
          "type": "string",
          "default": "default",
          "description": "Zeus profile used for explicit analysis requests."
        },
        "zeus.defaultDenseLevel": {
          "type": "string",
          "enum": [
            "lite",
            "full",
            "ultra"
          ],
          "default": "full",
          "description": "Context density for generated analysis artifacts."
        },
        "zeus.workingSourceRoot": {
          "type": "string",
          "default": "",
          "description": "Optional workspace-relative source root. Empty means infer it from the current file."
        },
        "zeus.outputRoot": {
          "type": "string",
          "default": ".zeus/output",
          "description": "Workspace-relative output root for reports and evidence artifacts."
        },
        "zeus.cliPath": {
          "type": "string",
          "default": "",
          "description": "Optional workspace-relative path or executable name for the Zeus CLI. Empty uses the workspace CLI when available."
        }
      }
    },
    "capabilities": {
      "untrustedWorkspaces": {
        "supported": false
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "check": "npm run compile -- --noEmit && npm test",
    "test": "node --test test/*.test.js",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.6.0",
    "typescript": "^5.8.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gzeuner/zeus-rpg-promptkit"
  }
}
